#!/bin/sh
# Auto-stamp last-updated dates for any review or guide changed in this commit.
# Never blocks a commit.
#
# The grep decides when to run, and the `git add` decides what actually reaches
# the commit. Both need every store the stamper writes: a file the stamper
# touches but the hook does not re-stage gets its date written to the working
# tree and left out of the commit it was computed for.
if git diff --cached --name-only | grep -qE '^(data/(sites|rip-sites)\.json|app/(guides|states)/.*page\.tsx|app/daily-sc/page\.tsx)$'; then
  node scripts/stamp-updated.js || exit 0
  git add data/sites.json data/rip-sites.json data/guide-dates.json 2>/dev/null || true
fi
exit 0
